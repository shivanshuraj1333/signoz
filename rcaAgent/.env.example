# Server Configuration
PORT=8080
WEBHOOK_PATH=/webhook

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=signoz_alerts
DB_SSL_MODE=disable

# SignOz API Configuration
SIGNOZ_API_URL=https://api.signoz.io/api/v3/query_range
SIGNOZ_API_KEY="your-signoz-api-key"
SIGNOZ_RULES_API_URL=https://api.signoz.io

# Default Query Parameters
QUERY_STEP=60
QUERY_WINDOW_HOURS=1 